{
  "_comment": "Portability study: wide 6-wide core, large window and L2, longer memory latency",
  "name": "riscv_ooo_big",
  "cpu": {
    "type": "DerivO3CPU",
    "clock": "2GHz",
    "fetch_width": 6,
    "decode_width": 6,
    "rename_width": 6,
    "dispatch_width": 6,
    "issue_width": 6,
    "commit_width": 6,
    "squash_width": 6,
    "wb_width": 12,
    "num_int_regs": 416,
    "num_fp_regs": 416,
    "num_rob_entries": 384,
    "num_iq_entries": 192,
    "lq_entries": 128,
    "sq_entries": 96,
    "_regs_comment": "physical regs = 32 arch + largest ROB, so the register file never binds before the window",
    "latency_cycles": {
      "int_alu": 1,
      "int_mul": 3,
      "int_div": 20,
      "fp_add": 2,
      "fp_mul": 4,
      "fp_fma": 5,
      "fp_div": 12,
      "fp_sqrt": 24,
      "load_hit": 5,
      "branch_mispredict": 12
    }
  },
  "cache": {
    "l1i_size": "64kB",
    "l1d_size": "48kB",
    "l2_size": "2MB",
    "cache_line_size": 64,
    "line_size": 64,
    "l1i": {
      "size": "64kB",
      "assoc": 4,
      "tag_latency": 1,
      "data_latency": 1,
      "response_latency": 1,
      "mshrs": 8,
      "tgts_per_mshr": 20,
      "hit_latency_cycles": 2
    },
    "l1d": {
      "size": "48kB",
      "assoc": 12,
      "tag_latency": 2,
      "data_latency": 3,
      "response_latency": 1,
      "mshrs": 24,
      "tgts_per_mshr": 20,
      "hit_latency_cycles": 5
    },
    "l2": {
      "size": "2MB",
      "assoc": 16,
      "tag_latency": 12,
      "data_latency": 12,
      "response_latency": 4,
      "mshrs": 48,
      "tgts_per_mshr": 12,
      "hit_latency_cycles": 26
    },
    "l1d_prefetcher": "none"
  },
  "memory": {
    "mem_size": "512MB",
    "mem_type": "DDR4_2400_8x8",
    "type": "DDR4_2400_8x8",
    "size": "512MB",
    "extra_latency_ns": 40,
    "latency_cycles": 280,
    "_comment": "latency_cycles is the cost-model estimate of an L2-miss round trip (DRAM + controller + extra_latency_ns); gem5 models it in detail"
  },
  "window": {
    "rob": [
      96,
      192,
      288,
      384
    ],
    "iq": [
      48,
      96,
      144,
      192
    ],
    "lq": [
      32,
      64,
      96,
      128
    ],
    "sq": [
      24,
      48,
      72,
      96
    ],
    "initial": 3,
    "period": 1000,
    "_comment": "config i scales ROB/IQ/LQ/SQ together; setwin(W) picks the smallest config with rob >= W (W=0 or too large -> largest)"
  },
  "rob": {
    "_comment": "legacy keys read by sim/run_baseline.py",
    "default_size": 384,
    "sweep_sizes": [
      96,
      192,
      288,
      384
    ]
  }
}
