+unsigned
+InstructionQueue::physEntries() const
+{
+    unsigned n = 0;
+    for (auto iq : iqs)
+        n += iq->numEntries();
+    return n;
+}
+
+unsigned
+InstructionQueue::occupancy() const
+{
+    unsigned n = 0;
+    for (auto iq : iqs)
+        n += iq->occupancy();
+    return n;
+}
+
+unsigned
+InstructionQueue::getCap() const
+{
+    unsigned n = 0;
+    for (auto iq : iqs)
+        n += iq->getCap();
+    return n;
+}
+
+void
+InstructionQueue::setCap(unsigned cap)
+{
+    const unsigned phys = std::max(1u, physEntries());
+    for (auto iq : iqs) {
+        if (iqs.size() == 1) {
+            iq->setCap(cap);
+        } else {
+            uint64_t share =
+                ((uint64_t)cap * iq->numEntries() + phys / 2) / phys;
+            iq->setCap((unsigned)share);
+        }
+    }
+}
+
 // Might want to do something more complex if it knows how many instructions
 // will be issued this cycle.
