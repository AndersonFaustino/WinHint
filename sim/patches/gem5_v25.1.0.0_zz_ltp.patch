+void
+InstructionQueue::insertParked(const DynInstPtr &new_inst)
+{
+    assert(new_inst);
+    if (new_inst->isFloating()) {
+        iqIOStats.fpInstQueueWrites++;
+    } else if (new_inst->isVector()) {
+        iqIOStats.vecInstQueueWrites++;
+    } else {
+        iqIOStats.intInstQueueWrites++;
+    }
+
+    DPRINTF(IQ, "Adding parked instruction [sn:%llu] PC %s to the IQ.\n",
+            new_inst->seqNum, new_inst->pcState());
+
+    // Keep instList sorted by age: released instructions are older than
+    // the urgent ones that bypassed them.
+    auto &list = instList[new_inst->threadNumber];
+    auto pos = list.end();
+    while (pos != list.begin() &&
+           (*std::prev(pos))->seqNum > new_inst->seqNum) {
+        --pos;
+    }
+    list.insert(pos, new_inst);
+
+    auto iq = findIQ(new_inst);
+    assert(iq);
+    iq->insert(new_inst);
+
+    addToDependents(new_inst);
+    // No addToProducers(): done when the instruction was parked.
+
+    if (new_inst->isMemRef()) {
+        memDepUnit[new_inst->threadNumber].insert(new_inst);
+    } else {
+        addIfReady(new_inst);
+    }
+
+    ++iqStats.instsAdded;
+}
+
+void
+InstructionQueue::forgetParkedProducer(const DynInstPtr &inst)
+{
+    for (int i = 0; i < inst->numDestRegs(); i++) {
+        PhysRegIdPtr dest_reg = inst->renamedDestIdx(i);
+        if (dest_reg->isAlwaysReady())
+            continue;
+        // Only clear the head if this instruction still owns it.
+        if (dependGraph.empty(dest_reg->flatIndex())) {
+            dependGraph.clearInst(dest_reg->flatIndex());
+        } else {
+            // Younger consumers are squashed with it and were removed by
+            // doSquash(); anything left is stale -- drop it.
+            while (!dependGraph.empty(dest_reg->flatIndex()))
+                dependGraph.pop(dest_reg->flatIndex());
+            dependGraph.clearInst(dest_reg->flatIndex());
+        }
+    }
+}
